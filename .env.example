# ===========================================
# DecisionVault Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials.
# ===========================================

# --- Server ---
PORT=3001
NODE_ENV=development
DB_PATH=./data/decisionvault.db

# --- Gemini API (SERVER-SIDE ONLY) ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Firebase Admin (SERVER-SIDE ONLY) ---
# Option 1: Set GOOGLE_APPLICATION_CREDENTIALS to path of service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Option 2: Set project ID (if running on GCP with default credentials)
FIREBASE_PROJECT_ID=decision-vaultx

# --- Firebase Client (PUBLIC — safe for client-side) ---
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=decision-vaultx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=decision-vaultx
VITE_FIREBASE_STORAGE_BUCKET=decision-vaultx.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=385523564979
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-MPGZQVYW23

# --- API URL (client → server) ---
VITE_API_URL=http://localhost:3001
